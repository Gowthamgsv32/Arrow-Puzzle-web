# ---- AI agent (controls mouse, keyboard, terminal, Chrome, clipboard, files) ----
# Get a key at https://console.anthropic.com  -> the agent turns on automatically.
# ANTHROPIC_API_KEY=sk-ant-...
# PA_AGENT_MODEL=claude-opus-5-5
# PA_AGENT_EFFORT=medium          # low (fastest/cheapest) | medium | high | xhigh | max
# Spoken AI tasks must start with one of these words (typed tasks never need it).
# Set it empty to send every sentence that isn't a built-in command to the AI.
# PA_AGENT_WAKE_WORD=assistant,அசிஸ்டன்ட்,அசிஸ்டென்ட்
# PA_WORKSPACE=C:\Users\you\projects   # default folder for terminal commands
# PA_CHROME_PATH=                  # only if Chrome isn't found automatically
# PA_AUTO_APPROVE=false            # true = never ask before risky commands (not recommended)

# Optional settings. Put this file (renamed to .env) next to PersonalAssistant.exe,
# or in %LOCALAPPDATA%\PersonalAssistant\.env

# Languages the assistant understands (each needs locales/<code>.yaml)
PA_LANGUAGES=en,ta
PA_DEFAULT_LANGUAGE=en

# Whisper model: tiny | base | small | medium | large-v3
# "small" or bigger is recommended for Tamil; "medium" is more accurate but slower.
PA_WHISPER_MODEL=small
PA_WHISPER_DEVICE=cpu          # cpu | cuda (NVIDIA GPU)
PA_WHISPER_COMPUTE_TYPE=int8   # int8 (CPU) | float16 (GPU)

# Always-listening tuning
PA_VAD_MIN_RMS=0.010           # raise (e.g. 0.02) if background noise triggers it
PA_VAD_SILENCE_MS=700          # pause that ends a sentence
PA_VAD_MAX_SECONDS=15

# Optional wake word(s), comma separated. Empty = every recognised command runs.
# PA_WAKE_WORD=assistant,அசிஸ்டன்ட்
