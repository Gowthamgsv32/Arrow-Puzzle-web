# Copy to .env and adjust. All values are optional.

# Languages the assistant understands (ISO 639-1 codes; each needs a locale file
# in src/personal_assistant/locales/<code>.yaml)
PA_LANGUAGES=en,ta
PA_DEFAULT_LANGUAGE=en

# Whisper model: tiny | base | small | medium | large-v3
# "small" or bigger is recommended for Tamil.
PA_WHISPER_MODEL=small
PA_WHISPER_DEVICE=cpu          # cpu | cuda
PA_WHISPER_COMPUTE_TYPE=int8   # int8 (CPU) | float16 (GPU)

# Seconds of audio captured per push-to-talk turn
PA_RECORD_SECONDS=5
